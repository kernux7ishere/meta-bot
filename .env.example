# Messenger AI Userbot - Environment Variables

# Facebook user ID of the owner account (the account running this bot)
OWNER_ID=100012345678901

# Path to the exported appstate / cookies JSON file
APPSTATE_PATH=./appstate.json

# LLM Configuration (OpenAI compatible endpoint: OpenAI, Anthropic via proxy, Gemini via proxy/gateway, Ollama, Groq, OpenRouter, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o
LLM_VISION=true

# Cloudflare Worker D1 Gateway URL & Bearer Token
GATEWAY_URL=https://messenger-d1-gateway.<your-subdomain>.workers.dev
GATEWAY_TOKEN=your-random-secure-gateway-token

# Tool APIs (optional / recommended)
# Either Tavily or Brave Search can be used for search_web
TAVILY_API_KEY=
BRAVE_API_KEY=

# Jina Reader prefix (default: https://r.jina.ai/)
JINA_READER_URL=https://r.jina.ai/

# Behavioral Limits and Tuning
HISTORY_LIMIT=20
DEFAULT_SUMMARY_N=100
SELF_THREAD_ID=
MAX_TOOL_CALLS=3
RATE_LIMIT_PER_USER_PER_MIN=5
MAX_REPLY_CHARS=1800
MEMORY_MAX_CHARS=50000
STYLE_MAX_CHARS=4000
AUTO_LEARN_EVERY=100
RETENTION_DAYS=7

# Delay before sending message to mimic human pacing (milliseconds)
MIN_DELAY_MS=1000
MAX_DELAY_MS=2500

# Logging level: trace, debug, info, warn, error
LOG_LEVEL=info
