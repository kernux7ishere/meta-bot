# Messenger AI Userbot - Environment Variables

# Facebook user ID of the owner account (the account running this bot)
OWNER_ID=100012345678901

# Path to the exported appstate / cookies JSON file
APPSTATE_PATH=./appstate.json

# LLM Configuration (OpenAI compatible endpoint: OpenAI, Anthropic via proxy, Gemini via proxy/gateway, Ollama, Groq, OpenRouter, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o
LLM_VISION=true

# Storage backend: "sqlite" (default — local bot.db, the store since
# 2026-11-11), "gateway" (Cloudflare D1 via the Worker, rollback only),
# or "memory" (in-memory, nothing persists). SQLITE_PATH is the SQLite
# file, relative to the bot dir (":memory:" is allowed). bot.db is
# NEVER included in deploy tars — it holds all live data.
DB_BACKEND=sqlite
SQLITE_PATH=./bot.db

# Cloudflare Worker D1 Gateway URL & Bearer Token
# (rollback backend only — the bot no longer reads/writes D1 by default)
GATEWAY_URL=https://messenger-d1-gateway.<your-subdomain>.workers.dev
GATEWAY_TOKEN=your-random-secure-gateway-token

# Tool APIs (optional / recommended)
# Either Tavily or Brave Search can be used for search_web
TAVILY_API_KEY=
BRAVE_API_KEY=

# Jina Reader prefix (default: https://r.jina.ai/)
JINA_READER_URL=https://r.jina.ai/

# Behavioral Limits and Tuning
HISTORY_LIMIT=20
DEFAULT_SUMMARY_N=100
SELF_THREAD_ID=
MAX_TOOL_CALLS=3
RATE_LIMIT_PER_USER_PER_MIN=5
MAX_REPLY_CHARS=1800
MEMORY_MAX_CHARS=50000
STYLE_MAX_CHARS=4000
AUTO_LEARN_EVERY=100
RETENTION_DAYS=7

# Emoji reaction: the bot picks a diverse, context-aware emoji per message.
# REACTION_EMOJI is only one fallback option in the pool, not a fixed answer.
# REACTION_RATE (0-1) is the chance a reply gets a reaction — occasional,
# not every message. Default 0.3.
REACTION_EMOJI=❤️
REACTION_ENABLED=true
REACTION_RATE=0.3

# Anti-checkpoint pacing (doc §6.3): outgoing messages are spaced by at
# least SEND_MIN_GAP_MS plus a random jitter up to SEND_JITTER_MS, so the
# bot never fires message bursts (a burst reads as automation). Applies
# to text, stickers and files, across all threads.
SEND_MIN_GAP_MS=1500
SEND_JITTER_MS=1000

# Human "reading" pause before an AI reply is sent (random between min
# and max). In 'user' typing mode this happens before the typing
# indicator starts; in 'bot' mode it happens before the reply is sent.
# 0/0 disables.
REPLY_DELAY_MIN_MS=800
REPLY_DELAY_MAX_MS=2500

# Logging level: trace, debug, info, warn, error
LOG_LEVEL=info
